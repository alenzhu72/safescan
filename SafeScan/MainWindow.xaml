<Window x:Class="SafeScan.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SafeScan 信息窃取木马排查工具" Width="1380" Height="820" MinWidth="1000" MinHeight="620" Background="#F4F7FB">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="SafeScan" FontSize="30" FontWeight="Bold" Foreground="#172033"/>
        <TextBlock Text="密码盗取线索 · 键盘监听/可疑服务 · 木马持久化（排除 OneDrive 与 WPS 网盘）" Foreground="#526078" FontSize="14"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#E8F2FF" CornerRadius="8" Padding="14,8" HorizontalAlignment="Right"><TextBlock Text="默认操作：隔离" Foreground="#1764C0" FontWeight="SemiBold"/></Border>
    </DockPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <WrapPanel>
        <Button x:Name="ScanButton" Content="开始本机扫描" Background="#2563EB" Foreground="White" Click="Scan_Click"/>
        <Button x:Name="DefenderButton" Content="运行 Defender 快速扫描" Click="Defender_Click"/>
        <Button x:Name="CancelButton" Content="停止" Click="Cancel_Click" IsEnabled="False"/>
        <Separator Width="16" Opacity="0"/>
        <Button Content="全选可处理项" Click="SelectAll_Click"/>
        <Button Content="清除选择" Click="ClearSelection_Click"/>
        <Button Content="隔离所选" Click="Quarantine_Click" Background="#D97706" Foreground="White"/>
        <Button Content="永久删除所选" Click="Delete_Click" Foreground="#B91C1C"/>
        <Button Content="导出报告" Click="Export_Click"/>
      </WrapPanel>
    </Border>
    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="8">
      <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Findings}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFC">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
          <DataGridTextColumn Header="风险" Binding="{Binding Risk}" IsReadOnly="True" Width="70"/>
          <DataGridTextColumn Header="类型" Binding="{Binding Kind}" IsReadOnly="True" Width="110"/>
          <DataGridTextColumn Header="路径/项目" Binding="{Binding Path}" IsReadOnly="True" Width="2*"/>
          <DataGridTextColumn Header="理由" Binding="{Binding Reason}" IsReadOnly="True" Width="1.6*"/>
          <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" IsReadOnly="True" Width="150"/>
          <DataGridTextColumn Header="签名" Binding="{Binding SignatureStatus}" IsReadOnly="True" Width="120"/>
          <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" IsReadOnly="True" Width="140"/>
          <DataGridTextColumn Header="创建时间" Binding="{Binding Created}" IsReadOnly="True" Width="140"/>
          <DataGridTextColumn Header="修改时间" Binding="{Binding Modified}" IsReadOnly="True" Width="140"/>
          <DataGridCheckBoxColumn Header="受保护" Binding="{Binding Protected}" IsReadOnly="True" Width="72"/>
          <DataGridTextColumn Header="状态" Binding="{Binding Status}" IsReadOnly="True" Width="90"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Grid Grid.Row="3" Margin="2,12,2,0">
      <ProgressBar x:Name="BusyBar" Height="4" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Top"/>
      <DockPanel Margin="0,10,0,0"><TextBlock x:Name="StatusText" Text="准备就绪" Foreground="#526078"/><TextBlock x:Name="CountText" DockPanel.Dock="Right" Text="0 项结果" FontWeight="SemiBold"/></DockPanel>
    </Grid>
  </Grid>
</Window>
